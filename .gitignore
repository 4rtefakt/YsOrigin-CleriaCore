# ---------------------------------------------------------------------------
# Game data — NEVER commit. This is Falcom's copyrighted content; CleriaCore is a
# clean-room engine that READS it. Extract it from your own copy of the game:
#   python tools/extract_assets.py <install>/release/data.ni    assets
#   python tools/extract_assets.py <install>/release/data_us.ni assets   # US overlay, 2nd
/assets/
*.ni
*.na
*.nu
*.nya

# Prebuilt dependencies (SDL3 + wgpu-native) — fetched, not authored.
/third_party/

# Secondary CMake build tree (used for wiring-phase test builds) — pure output, never tracked.
/build_diff/

# ---------------------------------------------------------------------------
# Build tree: ignore it wholesale, then re-admit the reverse-engineering notes.
# The agents write findings under build/<subsystem>_re/, and those notes are the
# most valuable artefact here — they are why we don't have to guess the same thing
# twice. Keep the prose and the probes; keep out the game data they extract.
/build/*
!/build/aso_re/
!/build/audio_re/
!/build/ef2_re/
!/build/enemy_re/
!/build/entity_re/
!/build/hud_re/
!/build/render_re/
!/build/sidecar_re/
!/build/source_map/
!/build/xso_ops/
!/build/ymo_re/
# Re-admit EVERY reverse-engineering dir, not just the hand-listed ones above -- the
# whitelist kept going stale as new subsystem_re dirs were added, leaving most of the RE
# (warp_re, combat_re, actor_re, ai_re, physics_re, ...) untracked despite the intent
# stated above. This catches all of them; the exclusions below keep the bulk out.
!/build/*_re/

# RE progress artifacts (top-level build/, so not caught by the *_re re-admit): the gap
# roadmap, the coverage metric + its report, and the committed function list that lets
# tools/re_coverage.py recompute coverage without Ghidra.
!/build/ROADMAP.md
!/build/RE_COVERAGE.md
!/build/RE_INDEX.md
!/build/IMPLEMENTATION_READINESS.md
!/build/re_coverage.json
!/build/re_coverage/
!/build/re_coverage/all_functions.txt

# ...but never the extracted assets or renders those dirs accumulate.
# Also keep out the regenerable raw Ghidra dumps (the *.java probes stay; their *_out.txt
# outputs are large and reproducible), so only the curated prose+scripts are tracked.
/build/**/*_out.txt
/build/**/*.jpg
/build/**/*.jpeg
/build/**/*.npy
/build/**/*.ppm
/build/**/*.png
/build/**/*.gif
/build/**/*.dds
/build/**/*.DDS
/build/**/*.EF2
/build/**/*.dat
/build/**/*.DAT
/build/**/*.z
/build/**/*.Z
/build/**/eft/
/build/**/__pycache__/

# ---------------------------------------------------------------------------
# Reference screenshots of the real game UI (Falcom's copyrighted content -- ground truth for
# the reimplementation, kept locally, NOT committed). Track only the README (the convention).
/reference/*
!/reference/README.md

# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.obj
*.exe
*.pdb
*.ilk
.vs/
yso_win.ini
